# Configuration Nginx HTTPS (après Certbot sur le VPS)
# Copier vers deploy/docker/nginx.conf et monter /etc/letsencrypt

upstream paiement_fisc_app {
    server app:8000;
}

server {
    listen 80;
    server_name votre-domaine.fr;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name votre-domaine.fr;

    ssl_certificate     /etc/letsencrypt/live/votre-domaine.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/votre-domaine.fr/privkey.pem;

    client_max_body_size 16M;

    location /static/ {
        alias /var/www/static/;
        expires 7d;
    }

    location /uploads/poi/ {
        alias /var/www/uploads/poi/;
        expires 7d;
    }

    location / {
        proxy_pass http://paiement_fisc_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_read_timeout 120s;
    }
}
