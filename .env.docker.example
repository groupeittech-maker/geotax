# Copier vers .env sur le VPS : cp .env.docker.example .env

# --- PostgreSQL (conteneur PostGIS) ---
POSTGRES_USER=paiement_fisc
POSTGRES_PASSWORD=changez-ce-mot-de-passe-fort
POSTGRES_DB=paiement_fisc

# --- Application Flask ---
FLASK_ENV=production
SECRET_KEY=changez-cette-cle-secrete-longue

# Cookies HTTPS : false uniquement pour test HTTP avant Certbot
SESSION_COOKIE_SECURE=true

# --- Port exposé par Nginx (seul port public) ---
HTTP_PORT=80

# --- Gunicorn (VPS 1-2 Go RAM : 2 workers) ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_MAX_REQUESTS=1000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Google Maps (optionnel) ---
GOOGLE_MAPS_API_KEY=

# --- Sauvegardes (deploy/backup.sh) ---
# BACKUP_DIR=/var/backups/paiement-fisc
# BACKUP_RETENTION_DAYS=14
# BACKUP_OFFSITE_DIR=/mnt/backup-offsite/paiement-fisc

# DATABASE_URL et REDIS_URL sont injectées par docker-compose
# Migrations : docker compose exec app flask db upgrade
# Santé : curl http://localhost/health/ready

# SMTP — notifications du formulaire de contact (landing page)
# Hostinger : smtp.hostinger.com, port 465 (SSL) ou 587 (STARTTLS)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=conctact@ittechmed.com
MAIL_TO=conctact@ittechmed.com
