# Copier vers .env : cp .env.example .env

# --- PostgreSQL (obligatoire en production) ---
DATABASE_URL=postgresql://paiement_fisc:MOT_DE_PASSE@localhost:5432/paiement_fisc

# --- Redis (optionnel — cache carte + tâches RQ) ---
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=60
RQ_QUEUE_NAME=geotax

# --- Application ---
FLASK_ENV=production
SECRET_KEY=changez-cette-cle-secrete-longue

# Cookies HTTPS (false uniquement en test HTTP local)
SESSION_COOKIE_SECURE=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Gunicorn ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_MAX_REQUESTS=1000

# --- Google Maps (optionnel) ---
GOOGLE_MAPS_API_KEY=

# --- Développement local ---
# FLASK_DEBUG=1
# FLASK_ENV=development

# Migrations : flask db upgrade
# Vérifier la migration : python deploy/verify_migration_status.py

# SMTP — notifications du formulaire de contact (landing page)
# Hostinger : smtp.hostinger.com, port 465 (SSL) ou 587 (STARTTLS)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=conctact@ittechmed.com
MAIL_TO=conctact@ittechmed.com
